IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_API_KEY=
STEAM_ID=

# Local IGDB proxy (npm run proxy prints the exact line to paste)
EXPO_PUBLIC_IGDB_PROXY_URL=

# Supabase (§8 שלב 4 — auth + sync). Project Settings → API באתר Supabase.
# אלה בטוחים בבאנדל (EXPO_PUBLIC_*) — ה-anon key מוגן ע"י RLS, לא סוד.
# ריק = האפליקציה ממשיכה לעבוד לגמרי אופליין, בלי auth/sync (isSupabaseConfigured() === false).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (§8 שלב 4 — paywall). Project settings → API keys ב-RevenueCat
# dashboard, מפתח נפרד לכל חנות (שניהם public keys, בטוחים בבאנדל).
# ריק = מסך ה-paywall ממשיך לעבוד עם mock gateway, בלי SDK אמיתי
# (isRevenueCatConfigured() === false) — ראה HANDOFF.md להוראות הקמה מלאות.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob (§5 — פרסומות באנר בספרייה, Free בלבד). Ad units → AdMob dashboard.
# ריק = נופל בחזרה למזהי הבדיקה הרשמיים של Google (TestIds.BANNER) — עדיין
# מציג פרסומת בדיקה אמיתית, לא כלום. App ID (ב-app.json, לא כאן) גם הוא
# עדיין מזהה הבדיקה של Google — להחליף בזמן הקמת חשבון AdMob אמיתי, ראה
# HANDOFF.md.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=

# PostHog (§8 שלב 4 — אנליטיקס). Project Settings → API Keys ב-PostHog.
# ה-project API key מיועד להיות ציבורי (בטוח בבאנדל, כמו anon key של
# Supabase). ריק = נופל בחזרה ל-mock gateway, שום קריאת רשת לא נשלחת
# (isPostHogConfigured() === false).
EXPO_PUBLIC_POSTHOG_API_KEY=
# ברירת מחדל: https://us.i.posthog.com — לשנות רק אם הפרויקט ב-EU cloud.
EXPO_PUBLIC_POSTHOG_HOST=
