IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_API_KEY=
STEAM_ID=

# Local IGDB proxy (npm run proxy prints the exact line to paste)
EXPO_PUBLIC_IGDB_PROXY_URL=

# Supabase (§8 שלב 4 — auth + sync). Project Settings → API באתר Supabase.
# אלה בטוחים בבאנדל (EXPO_PUBLIC_*) — ה-anon key מוגן ע"י RLS, לא סוד.
# ריק = האפליקציה ממשיכה לעבוד לגמרי אופליין, בלי auth/sync (isSupabaseConfigured() === false).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
